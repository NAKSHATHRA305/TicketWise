# --- Database (Neon PostgreSQL - permanently free tier, no expiration) ---
# Get this from neon.tech after creating a project: Dashboard -> Connection string
DATABASE_URL="postgresql://neondb_owner:npg_Ys8IJZV1bNfx@ep-raspy-mud-az88jir4.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=requirey"

# --- AWS (used for Comprehend classification + optional S3 attachments) ---
# These are billed per-request, not per-hour, so idle cost is $0 even after
# any free-tier window closes. Safe to leave configured indefinitely.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Set to "true" once AWS Comprehend credentials above are filled in.
# Until then, the app uses a built-in rule-based classifier so it runs with zero AWS setup.
USE_AWS_COMPREHEND="false"

# Optional: S3 bucket for ticket attachments
S3_ATTACHMENTS_BUCKET="ticketwise-attachments"
